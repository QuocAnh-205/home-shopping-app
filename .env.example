# ============================================================
# Biến môi trường production - nội dung file này (đã điền giá trị thật) lưu vào
# GitHub Secret "PROD_ENV_FILE". Pipeline ghi ra /opt/homeshop/.env (chmod 600) mỗi lần deploy.
# Sinh mật khẩu an toàn (chỉ ký tự hex → không phải escape trong URL):  openssl rand -hex 32
# ============================================================

# --- Domain & TLS ---
DOMAIN=shop.example.com
LETSENCRYPT_EMAIL=admin@example.com
# 1 = dùng Let's Encrypt staging khi thử nghiệm (tránh rate limit)
LETSENCRYPT_STAGING=0
CORS_ORIGINS=https://shop.example.com

# --- PostgreSQL ---
POSTGRES_USER=homeshop
POSTGRES_PASSWORD=
POSTGRES_DB=homeshop

# --- Redis ---
REDIS_PASSWORD=

# --- Backend ---
# >= 32 ký tự
JWT_SECRET=
JWT_EXPIRES_IN=1d
# true = mở Swagger UI tại /api/docs (chỉ nên bật khi demo)
SWAGGER_ENABLED=false
# URL công khai của web (link trong email đặt lại mật khẩu + redirect URI của Google/Facebook)
APP_URL=https://shop.example.com

# --- Email (quên mật khẩu, bản tin). Ví dụ Amazon SES: smtps://SMTP_USER:SMTP_PASS@email-smtp.ap-southeast-1.amazonaws.com:465
SMTP_URL=
MAIL_FROM="Home Shopping <no-reply@shop.example.com>"

# --- Đăng nhập mạng xã hội (để trống = ẩn nút). Redirect URI: ${APP_URL}/api/auth/oauth/<google|facebook>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Thanh toán online (để trống = phương thức đó ẩn / dùng giả lập) ---
# Cổng giả lập cho demo khi chưa có khóa VNPay/MoMo thật (KHÔNG bật cho cửa hàng thật)
PAYMENT_MOCK_ENABLED=false
# Phút giữ hàng cho đơn online chưa thanh toán
PAYMENT_HOLD_MINUTES=15
# URL công khai cho IPN (mặc định = APP_URL). IPN VNPay: ${base}/api/payments/ipn/vnpay (khai báo trong cổng merchant)
PAYMENT_IPN_BASE_URL=
# VNPay sandbox: đăng ký tại https://sandbox.vnpayment.vn/devreg/ → nhận TMN code + hash secret qua email
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Mặc định sandbox; production: https://pay.vnpay.vn/vpcpay.html
VNPAY_PAY_URL=
VNPAY_API_URL=
# MoMo sandbox: https://developers.momo.vn (bộ khóa test của tài khoản developer)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Mặc định https://test-payment.momo.vn
MOMO_ENDPOINT=
# Chuyển khoản VietQR: BIN ngân hàng (Napas, vd 970436 = Vietcombank), số tài khoản, tên chủ tài khoản (IN HOA không dấu)
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# --- Vận chuyển & đơn hàng ---
# Mã tỉnh kho hàng (79 = TP. Hồ Chí Minh, xem GET /api/locations/provinces)
SHOP_PROVINCE_CODE=79
# Đơn từ ngưỡng này (VND) được miễn phí vận chuyển; 0 = tắt
SHIPPING_FREE_THRESHOLD=500000
# Đơn "Đã giao" tự hoàn thành sau N ngày; thời hạn yêu cầu trả hàng (ngày kể từ khi giao)
ORDER_AUTO_COMPLETE_DAYS=3
RETURN_WINDOW_DAYS=15

# --- AWS (S3_BUCKET lấy từ `terraform output s3_bucket_name`; không cần access key) ---
S3_BUCKET=
AWS_REGION=ap-southeast-1

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Alerting (Alertmanager + backup script) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 = báo cả khi backup thành công
BACKUP_NOTIFY_SUCCESS=0
# Tạo sẵn tài khoản KHÁCH demo (khach@homeshop.local … / Khach12345) để giảng viên đăng nhập thử; admin demo không bao giờ được tạo ở production
SEED_DEMO_CUSTOMERS=false
