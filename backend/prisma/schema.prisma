generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

/// Vòng đời đơn hàng (state machine trong orders/order-state.ts)
enum OrderStatus {
  /// Chờ thanh toán (đơn thanh toán online, giữ hàng tối đa 15 phút)
  AWAITING_PAYMENT
  /// Chờ xác nhận
  PENDING
  /// Đang chuẩn bị hàng
  PROCESSING
  /// Đang giao
  SHIPPING
  /// Đã giao
  DELIVERED
  /// Hoàn thành (khách bấm "Đã nhận hàng" hoặc tự động sau N ngày)
  COMPLETED
  CANCELLED
  /// Khách yêu cầu trả hàng/hoàn tiền, chờ cửa hàng duyệt
  RETURN_REQUESTED
  /// Đã trả hàng/hoàn tiền
  RETURNED
}

enum ActorType {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum PaymentMethod {
  COD
  VNPAY
  MOMO
  VIETQR
}

/// Trạng thái từng lần thử thanh toán
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  /// Cổng không hỗ trợ hoàn tự động (chuyển khoản / COD): cửa hàng hoàn tay rồi đánh dấu
  MANUAL_REQUIRED
}

/// Trạng thái tiền của cả đơn (từng lần thử thanh toán nằm ở bảng payments)
enum OrderPaymentStatus {
  UNPAID
  PAID
  REFUND_PENDING
  REFUNDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AddressType {
  HOME
  OFFICE
}

/// Vùng giao hàng (tính phí ship bảng nội bộ)
enum Region {
  NORTH
  CENTRAL
  SOUTH
}

enum VoucherType {
  /// Giảm theo % (value = 1..100), giới hạn bởi maxDiscount
  PERCENT
  /// Giảm số tiền cố định (value = VND)
  FIXED
  /// Giảm phí vận chuyển (value = VND tối đa được giảm, 0 = miễn toàn bộ)
  FREESHIP
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  /// null = tài khoản chỉ đăng nhập qua Google/Facebook (chưa đặt mật khẩu)
  passwordHash        String?              @map("password_hash")
  fullName            String               @map("full_name")
  avatarUrl           String?              @map("avatar_url")
  /// Hồ sơ cá nhân (trang Tài khoản của tôi) – đều không bắt buộc
  phone               String?              @db.VarChar(15)
  gender              Gender?
  dateOfBirth         DateTime?            @map("date_of_birth") @db.Date
  role                Role                 @default(CUSTOMER)
  /// Admin khóa tài khoản: không đăng nhập được (mật khẩu lẫn Google/Facebook), mọi phiên bị thu hồi
  lockedAt            DateTime?            @map("locked_at")
  lockedReason        String?              @map("locked_reason") @db.VarChar(255)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  orders              Order[]
  reviews             Review[]
  oauthAccounts       OAuthAccount[]
  passwordResetTokens PasswordResetToken[]
  addresses           Address[]
  auditLogs           AdminAuditLog[]
  savedVouchers       UserVoucher[]
  voucherUsages       VoucherUsage[]

  @@index([createdAt])
  @@map("users")
}

/// Sổ địa chỉ giao hàng. Mỗi người dùng có tối đa 1 địa chỉ mặc định (partial unique index trong migration).
model Address {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String      @map("full_name") @db.VarChar(100)
  phone     String      @db.VarChar(15)
  /// Tên tỉnh/xã lưu kèm để hiển thị nhanh; mã hành chính (chuẩn 2 cấp từ 01/07/2025) dùng tính phí ship
  province     String      @db.VarChar(100)
  /// Cấp huyện đã bỏ từ 01/07/2025: chỉ còn ở địa chỉ cũ
  district     String?     @db.VarChar(100)
  ward         String      @db.VarChar(100)
  street       String      @db.VarChar(255)
  provinceCode Int?        @map("province_code")
  wardCode     Int?        @map("ward_code")
  type      AddressType @default(HOME)
  isDefault Boolean     @default(false) @map("is_default")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("addresses")
}

/// Tỉnh/thành theo đơn vị hành chính mới (34 tỉnh, hiệu lực 01/07/2025)
model Province {
  code   Int    @id
  name   String @db.VarChar(100)
  region Region
  wards  Ward[]

  @@map("provinces")
}

/// Xã/phường/đặc khu (3.321 đơn vị, không còn cấp huyện)
model Ward {
  code         Int      @id
  name         String   @db.VarChar(100)
  provinceCode Int      @map("province_code")
  province     Province @relation(fields: [provinceCode], references: [code])

  @@index([provinceCode])
  @@map("wards")
}

model OAuthAccount {
  id             Int           @id @default(autoincrement())
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id")
  userId         String        @map("user_id") @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now()) @map("created_at")

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Chỉ lưu SHA-256 của token → lộ DB cũng không dùng được link đặt lại mật khẩu
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id             String      @id @default(uuid()) @db.Uuid
  name           String
  slug           String      @unique
  description    String
  /// Điểm nổi bật hiển thị dạng danh sách ở trang chi tiết
  highlights     String[]    @default([])
  /// Thông số kỹ thuật dạng { "Nhãn": "Giá trị" }
  specs          Json        @default("{}")
  /// Tiền luôn là số nguyên VND (không dùng số thực)
  price          Int
  /// Giá gốc trước khuyến mãi; null = không giảm giá. Luôn > price (CHECK trong migration)
  compareAtPrice Int?        @map("compare_at_price")
  stock          Int         @default(0)
  /// Bộ đếm phi chuẩn hóa: cập nhật trong cùng transaction với đơn hàng / đánh giá → đọc nhanh, sắp xếp được
  soldCount      Int         @default(0) @map("sold_count")
  ratingAvg      Decimal     @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount    Int         @default(0) @map("rating_count")
  imageKey       String?     @map("image_key")
  /// Cân nặng & kích thước đóng gói: tính phí vận chuyển (khối lượng quy đổi = D×R×C/6000)
  weightGrams    Int         @default(500) @map("weight_grams")
  lengthCm       Int         @default(20) @map("length_cm")
  widthCm        Int         @default(20) @map("width_cm")
  heightCm       Int         @default(15) @map("height_cm")
  isHot          Boolean     @default(false) @map("is_hot")
  /// false = admin ẩn khỏi cửa hàng (không xóa vì đơn hàng cũ còn tham chiếu)
  isActive       Boolean     @default(true) @map("is_active")
  categoryId     Int         @map("category_id")
  category       Category    @relation(fields: [categoryId], references: [id])
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  orderItems     OrderItem[]
  reviews        Review[]

  @@index([categoryId])
  @@index([isHot])
  @@index([isActive])
  @@index([soldCount])
  // Tìm kiếm ILIKE '%từ khóa%' dùng được index nhờ pg_trgm (extension tạo trong migration)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

model Review {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String   @map("user_id") @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 1..5 (CHECK trong migration)
  rating           Int
  comment          String
  /// Người đánh giá đã từng mua sản phẩm (đơn không bị hủy) tại thời điểm viết
  verifiedPurchase Boolean  @default(false) @map("verified_purchase")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([productId, userId])
  @@index([productId, createdAt])
  @@index([createdAt])
  @@map("reviews")
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING)
  /// VND. totalAmount = subtotal + shippingFee − discountAmount − shippingDiscount
  totalAmount     Int         @map("total_amount")
  subtotal        Int         @default(0)
  shippingFee     Int         @default(0) @map("shipping_fee")
  /// Giảm giá từ voucher sản phẩm/đơn hàng
  discountAmount  Int         @default(0) @map("discount_amount")
  /// Giảm phí ship (voucher freeship / ngưỡng miễn phí)
  shippingDiscount Int        @default(0) @map("shipping_discount")
  /// Snapshot địa chỉ lúc đặt (sổ địa chỉ có sửa/xóa sau đó cũng không ảnh hưởng đơn)
  shippingAddress String      @map("shipping_address")
  recipientName   String?     @map("recipient_name") @db.VarChar(100)
  phone           String
  provinceCode    Int?        @map("province_code")
  wardCode        Int?        @map("ward_code")
  shippingProvider String?    @map("shipping_provider") @db.VarChar(32)
  estimatedDeliveryFrom DateTime? @map("estimated_delivery_from") @db.Date
  estimatedDeliveryTo   DateTime? @map("estimated_delivery_to") @db.Date
  note            String?     @db.VarChar(255)
  idempotencyKey  String      @unique @map("idempotency_key")
  paymentMethod   PaymentMethod      @default(COD) @map("payment_method")
  paymentStatus   OrderPaymentStatus @default(UNPAID) @map("payment_status")
  paidAt          DateTime?          @map("paid_at")
  /// Đơn online chưa trả tiền: quá hạn này job nền tự hủy, hoàn tồn kho và voucher
  paymentExpiresAt DateTime?         @map("payment_expires_at")
  cancelReason    String?            @map("cancel_reason") @db.VarChar(255)
  cancelledBy     ActorType?         @map("cancelled_by")
  confirmedAt     DateTime?          @map("confirmed_at")
  shippedAt       DateTime?          @map("shipped_at")
  deliveredAt     DateTime?          @map("delivered_at")
  completedAt     DateTime?          @map("completed_at")
  cancelledAt     DateTime?          @map("cancelled_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  items           OrderItem[]
  history         OrderStatusHistory[]
  /// Mã voucher đã dùng (snapshot): tối đa 1 voucher giảm giá + 1 voucher vận chuyển như Shopee
  voucherCode         String?        @map("voucher_code") @db.VarChar(32)
  shippingVoucherCode String?        @map("shipping_voucher_code") @db.VarChar(32)
  voucherUsages       VoucherUsage[]
  payments            Payment[]
  refunds             Refund[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([userId, status, createdAt])
  @@index([status, paymentExpiresAt])
  @@index([status, deliveredAt])
  @@map("orders")
}

model Voucher {
  id            String      @id @default(uuid()) @db.Uuid
  /// In hoa, A-Z 0-9 (CHECK trong migration)
  code          String      @unique @db.VarChar(32)
  name          String      @db.VarChar(120)
  description   String?     @db.VarChar(500)
  type          VoucherType
  value         Int
  /// Giảm tối đa (VND) cho voucher %
  maxDiscount   Int?        @map("max_discount")
  /// Đơn tối thiểu (VND), tính trên các sản phẩm thuộc phạm vi áp dụng
  minOrderValue Int         @default(0) @map("min_order_value")
  startsAt      DateTime    @map("starts_at")
  endsAt        DateTime    @map("ends_at")
  /// Tổng lượt dùng (null = không giới hạn); usedCount tăng bằng UPDATE có điều kiện → không vượt khi dùng đồng thời
  usageLimit    Int?        @map("usage_limit")
  usedCount     Int         @default(0) @map("used_count")
  perUserLimit  Int         @default(1) @map("per_user_limit")
  /// Phạm vi: rỗng = toàn shop; có giá trị = chỉ áp dụng cho danh mục / sản phẩm này
  categoryIds   Int[]       @default([]) @map("category_ids")
  productIds    String[]    @default([]) @map("product_ids") @db.Uuid
  isActive      Boolean     @default(true) @map("is_active")
  /// Hiện trong danh sách voucher & lưu được vào ví; false = mã riêng, phải nhập tay
  isPublic      Boolean     @default(true) @map("is_public")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  usages        VoucherUsage[]
  savedBy       UserVoucher[]

  @@index([isActive, endsAt])
  @@map("vouchers")
}

/// Ví voucher của người dùng ("Lưu" voucher như Shopee)
model UserVoucher {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucherId String   @map("voucher_id") @db.Uuid
  voucher   Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now()) @map("saved_at")

  @@id([userId, voucherId])
  @@index([voucherId])
  @@map("user_vouchers")
}

/// Mỗi lần voucher được dùng cho 1 đơn; xóa (và trả lượt) khi đơn bị hủy
model VoucherUsage {
  id        BigInt   @id @default(autoincrement())
  voucherId String   @map("voucher_id") @db.Uuid
  voucher   Voucher  @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String   @map("order_id") @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Số tiền được giảm (VND)
  discount  Int
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([voucherId, orderId])
  @@index([voucherId, userId])
  @@index([orderId])
  @@map("voucher_usages")
}

/// Mỗi lần thử thanh toán online của 1 đơn (thanh toán lại / đổi phương thức = bản ghi mới)
model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  /// VND, phải khớp tổng tiền đơn lúc tạo; IPN báo số khác → từ chối
  amount        Int
  status        PaymentStatus @default(PENDING)
  /// Mã tham chiếu gửi cổng (vnp_TxnRef / MoMo orderId / nội dung chuyển khoản)
  txnRef        String        @unique @map("txn_ref") @db.VarChar(64)
  /// Mã giao dịch phía cổng (vnp_TransactionNo / MoMo transId)
  gatewayTxnId  String?       @map("gateway_txn_id") @db.VarChar(64)
  payUrl        String?       @map("pay_url")
  /// VietQR: ngân hàng, số tài khoản, nội dung, ảnh QR
  qrData        Json?         @map("qr_data")
  expiresAt     DateTime      @map("expires_at")
  paidAt        DateTime?     @map("paid_at")
  failureReason String?       @map("failure_reason") @db.VarChar(255)
  /// Dữ liệu thô: lúc tạo giao dịch và lúc cổng xác nhận
  rawCreate     Json?         @map("raw_create")
  rawResult     Json?         @map("raw_result")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  events        PaymentEvent[]
  refunds       Refund[]

  @@index([orderId, createdAt])
  @@index([status, expiresAt])
  @@map("payments")
}

/// Nhật ký mọi callback/IPN nhận được (kể cả sai chữ ký, trùng lặp) – phục vụ đối soát
model PaymentEvent {
  id             BigInt        @id @default(autoincrement())
  paymentId      String?       @map("payment_id") @db.Uuid
  payment        Payment?      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  provider       PaymentMethod
  /// IPN | MANUAL | REFUND | CREATE
  kind           String        @db.VarChar(16)
  signatureValid Boolean       @map("signature_valid")
  /// processed | duplicate | failed | amount_mismatch | invalid_signature | unknown_ref | late_paid
  result         String        @db.VarChar(32)
  payload        Json
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([paymentId, createdAt])
  @@index([createdAt])
  @@map("payment_events")
}

model Refund {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// null = đơn COD đã thu tiền rồi trả hàng (hoàn tay)
  paymentId       String?      @unique @map("payment_id") @db.Uuid
  payment         Payment?     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount          Int
  status          RefundStatus @default(PENDING)
  reason          String       @db.VarChar(255)
  gatewayRefundId String?      @map("gateway_refund_id") @db.VarChar(64)
  attempts        Int          @default(0)
  lastError       String?      @map("last_error") @db.VarChar(500)
  raw             Json?
  completedAt     DateTime?    @map("completed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([status, createdAt])
  @@map("refunds")
}

/// Lịch sử trạng thái đơn (timeline): ai đổi, lúc nào, ghi chú
model OrderStatusHistory {
  id         BigInt       @id @default(autoincrement())
  orderId    String       @map("order_id") @db.Uuid
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorType  ActorType    @map("actor_type")
  actorId    String?      @map("actor_id") @db.Uuid
  note       String?      @db.VarChar(500)
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   String  @map("order_id") @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  /// VND
  unitPrice Int     @map("unit_price")
  /// Snapshot lúc đặt: sản phẩm có đổi tên/ảnh/giá sau đó, đơn vẫn hiển thị đúng thứ khách đã mua
  productName String  @map("product_name")
  productSlug String  @map("product_slug")
  imageKey    String? @map("image_key")

  @@index([orderId])
  @@map("order_items")
}

/// Nhật ký thao tác quản trị (ai, làm gì, lúc nào) – phục vụ truy vết & kiểm toán
model AdminAuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Ví dụ: order.status, product.update, user.lock, category.delete
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(32)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  summary    String   @db.VarChar(500)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("admin_audit_logs")
}
