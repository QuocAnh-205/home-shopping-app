# Sao chép thành terraform.tfvars (đã nằm trong .gitignore) rồi điền giá trị thật
aws_region   = "ap-southeast-1"
project_name = "homeshop"
environment  = "prod"
owner        = "nguyen-quoc-anh"

instance_type       = "t3.medium"
root_volume_size_gb = 30
swap_size_gb        = 4

# cat ~/.ssh/homeshop_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleReplaceWithYourOwnPublicKey homeshop-deployer"

# IP public của bạn: curl -s https://checkip.amazonaws.com  → thêm /32
ssh_allowed_cidrs     = ["203.0.113.10/32"]
grafana_allowed_cidrs = ["203.0.113.10/32"]

backup_retention_days = 30

github_repository           = "your-github-username/home-shopping-app"
create_github_oidc_provider = true
github_oidc_sub_prefix      = "" # repo mới: gh api repos/<owner>/<repo>/actions/oidc/customization/sub → sub_claim_prefix
