# ============================================================
# Template Alertmanager - render bởi scripts/render-alertmanager.sh → alertmanager.yml
# (secret Discord/Telegram nằm trong .env trên server, KHÔNG commit vào Git)
# ============================================================
global:
  resolve_timeout: 5m

route:
  receiver: ops-all
  group_by: [alertname, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Khẩn cấp: gửi ngay, nhắc lại mỗi 1h tới khi xử lý xong
    - matchers: ['severity="critical"']
      receiver: ops-all
      group_wait: 10s
      repeat_interval: 1h
    - matchers: ['severity="warning"']
      receiver: ops-discord
      repeat_interval: 6h

inhibit_rules:
  # Đã có cảnh báo critical thì không spam warning cùng loại
  - source_matchers: ['severity="critical"']
    target_matchers: ['severity="warning"']
    equal: [alertname, instance]
  # DB chết → 5xx tăng là hệ quả, chỉ báo nguyên nhân gốc
  - source_matchers: ['alertname=~"PostgresDown|RedisDown"']
    target_matchers: ['alertname=~"BackendHigh5xxRate|OrderFailuresSpike|BackendHighLatencyP95"']

receivers:
  - name: ops-all
    discord_configs:
      - webhook_url: '${DISCORD_WEBHOOK_URL}'
        send_resolved: true
        title: '{{ if eq .Status "firing" }}🚨 [{{ .CommonLabels.severity | toUpper }}]{{ else }}✅ [RESOLVED]{{ end }} {{ .CommonLabels.alertname }}'
        message: |-
          {{ range .Alerts }}**{{ .Annotations.summary }}**
          {{ .Annotations.description }}
          • Bắt đầu: {{ .StartsAt.Local.Format "15:04:05 02/01/2006" }}
          {{ end }}
    #TELEGRAM_START
    telegram_configs:
      - bot_token: '${TELEGRAM_BOT_TOKEN}'
        chat_id: ${TELEGRAM_CHAT_ID}
        parse_mode: HTML
        send_resolved: true
        message: |-
          {{ if eq .Status "firing" }}🚨 <b>[{{ .CommonLabels.severity | toUpper }}] {{ .CommonLabels.alertname }}</b>{{ else }}✅ <b>[RESOLVED] {{ .CommonLabels.alertname }}</b>{{ end }}
          {{ range .Alerts }}• {{ .Annotations.summary }}
          {{ .Annotations.description }}
          {{ end }}
    #TELEGRAM_END

  - name: ops-discord
    discord_configs:
      - webhook_url: '${DISCORD_WEBHOOK_URL}'
        send_resolved: true
        title: '{{ if eq .Status "firing" }}⚠️ [WARNING]{{ else }}✅ [RESOLVED]{{ end }} {{ .CommonLabels.alertname }}'
        message: |-
          {{ range .Alerts }}**{{ .Annotations.summary }}**
          {{ .Annotations.description }}
          {{ end }}
